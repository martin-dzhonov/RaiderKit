
QMainWindow,
QWidget,
QDialog {
    background: #10131d;
    color: #e8ecf8;
    font-family: "Segoe UI";
    font-size: 12px;
}

QMainWindow {
    background: transparent;
}

QLabel {
    color: #e8ecf8;
}

/* Main Frame */
QWidget#centralFrame {
    background: #10131d;
    border: 1px solid #454b5a;
    border-radius: 10px;
}

QWidget#loadoutContainer {
    background: transparent;
}

QWidget#panelDivider {
    margin-top: 12px;
    margin-bottom: 12px;
    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 0,
        y2: 1,
        stop: 0 rgba(137, 146, 173, 0),
        stop: 0.1 rgba(137, 146, 173, 85),
        stop: 0.5 rgba(190, 220, 255, 125),
        stop: 0.9 rgba(137, 146, 173, 85),
        stop: 1 rgba(137, 146, 173, 0)
    );
}

/* Title Bar */
QWidget#titleBar {
    background: #191e2d;
    border: none;
}

QLabel#windowTitle {
    background: transparent;
    color: #f4f6ff;
    font-size: 13px;
    font-weight: bold;
}

QLabel#title {
    color: #8edbff;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
}

QLabel#status {
    color: #6df5c4;
    font-weight: bold;
}

QLabel#hint {
    color: #8992ad;
    font-size: 11px;
}

QLabel#emptyLoadoutsMessage {
    color: rgba(190, 220, 255, 25);
    font-size: 20px;
    font-weight: 700;
}

/* =========================================================
   GENERAL BUTTONS
   ========================================================= */

QPushButton {
    background: #252b3e;
    color: #e8ecf8;
    border: 1px solid #353d57;
    border-radius: 8px;
    padding: 9px;
}

QPushButton:hover {
    border-color: #6df5c4;
}

QPushButton:pressed {
    background: #1d2333;
}

QPushButton:disabled {
    background: #1a1e2b;
    color: #626b83;
    border-color: #292e40;
}

/* Player Scan Button */
QPushButton#playerScan {
    background: #252b3e;
    color: #8edbff;
    border: 3px solid #35516b;
    border-radius: 8px;
    font-weight: bold;
    padding: 11px;
    font-size: 13px;
}

QPushButton#playerScan:hover {
    background: #2d3a50;
    border-color: #8edbff;
}

QPushButton#playerScan:disabled {
    background: #1a1e2b;
    color: #626b83;
    border: 3px solid #292e40;
}

/* Clear Loadout Button */
QPushButton#clearLoadout {
    color: #C46A72;
    border: 3px solid #9E4F58;
    border-radius: 8px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#clearLoadout:hover {
    color: #D98A91;
    border-color: #C46A72;
    background-color: rgba(196, 106, 114, 18);
}

QPushButton#clearLoadout:disabled {
    color: #76545d;
    border: 3px solid #49303a;
    background: #1a1e2b;
}

/* Scan Button */
QPushButton#scan {
    background: #D9B84C;
    color: #10131d;
    border: 1px solid #D9B84C;
    font-weight: bold;
}

QPushButton#scan:hover {
    background: #fff1ad;
    border-color: #FFE45C;
}

QPushButton#scan:pressed {
    background: #fffcee
}

QWidget#loadoutRow QPushButton#scan {
    padding: 0;
}

/* Quit Button */
QPushButton#quit {
    background: transparent;
    color: #ff9aaa;
    border: none;
}

QPushButton#quit:hover {
    background: rgba(255, 107, 129, 35);
    border: none;
}

/* Confirm Button */
QPushButton#confirm {
    background: #6df5c4;
    color: #10131d;
    border: 1px solid #6df5c4;
    font-weight: bold;
}

QPushButton#confirm:hover {
    background: #8affd5;
    border-color: #8affd5;
}

QPushButton#confirm:pressed {
    background: #52d9ab;
}

/* Hide Button */
QPushButton#hideButton {
    background: transparent;
    color: #c0c7da;
    border: none;
    border-radius: 6px;
    font-size: 11px;
    font-weight: bold;
    padding: 0px;
    qproperty-alignment: AlignCenter;
}

QPushButton#hideButton:hover {
    background: #30374a;
    color: #ffffff;
}

QPushButton#hideButton:pressed {
    background: #252b3e;
}

/* Close Button */
QPushButton#closeButton {
    background: #321e2b;
    color: #ff6b81;
    border: 1px solid #653044;
    border-radius: 6px;
    font-size: 11px;
    font-weight: bold;
    padding: 0px;
}

QPushButton#closeButton:hover {
    background: #e5485d;
    color: #ffffff;
    border-color: #e5485d;
}

QPushButton#closeButton:pressed {
    background: #b93249;
}

/* =========================================================
   TEXT INPUTS
   ========================================================= */

QLineEdit,
QTextEdit,
QPlainTextEdit {
    background: #191e2d;
    color: #e8ecf8;
    border: 1px solid #353d57;
    border-radius: 6px;
    padding: 6px;
    selection-background-color: #35516b;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: #6df5c4;
}

/* =========================================================
   DIALOGS
   ========================================================= */

QDialog {
    background: #10131d;
    color: #e8ecf8;
}

QDialog QLineEdit,
QDialog QPlainTextEdit {
    background: #191e2d;
    color: #e8ecf8;
    border: 1px solid #353d57;
    border-radius: 6px;
    padding: 8px;
}

QLineEdit#generatedLoadoutName {
    background: #1b2638;
    color: #f4f6ff;
    border: 1px solid #52718c;
    border-radius: 8px;
    padding: 9px 11px;
    min-height: 22px;
    font-size: 14px;
    selection-background-color: #35516b;
}

QLineEdit#generatedLoadoutName:focus {
    background: #202d40;
    border-color: #8edbff;
}

QDialog QPushButton {
    padding: 9px 18px;
}

/* =========================================================
   LOADOUT ENTRIES
   ========================================================= */

QWidget#loadoutEntry {
    background: #191e2d;
    border-radius: 8px;
}

QWidget#loadoutRow {
    background: #252c40;
    border-radius: 8px;
}

QWidget#loadoutRowContent {
    background: transparent;
}

QProgressBar#loadoutEquipProgress {
    background: transparent;
    border: none;
    border-radius: 8px;
}

QProgressBar#loadoutEquipProgress::chunk {
    background: rgba(109, 245, 196, 45);
    border-radius: 8px;
}

QCheckBox#loadoutTabOption {
    background: transparent;
    border: none;
    padding: 0;
}

QWidget#loadoutRow QLabel {
    background: transparent;
    border: none;
}

QWidget#loadoutContents {
    background: transparent;
    border: none;
}

QWidget#loadoutContents QLabel {
    background: transparent;
    border: none;
}

QWidget#loadoutContents QWidget {
    background: transparent;
    border: none;
}

QWidget#loadoutContents QFrame {
    background: transparent;
    border: none;
}

QWidget#loadoutContents QLabel#inventoryItemName {
    color: #d6dbe4;
    font-size: 12px;
    font-weight: bold;
    background: transparent;
    border: none;
}

/* Inventory Quantity */
QLabel#inventoryQuantity {
    color: white;
    background-color: rgb(15, 19, 30);
    border: none;
    border-radius: 5px;
    padding: 0px 2px;
    font-size: 14px;
    font-weight: bold;
}

QLabel#quantity {
    background: transparent;
    color: #6df5c4;
    font-weight: bold;
}

/* =========================================================
   SCROLL AREAS
   ========================================================= */

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* Vertical Scrollbar */
QScrollBar:vertical {
    width: 10px;
    background: #191e2d;
    border: none;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #454b5a;
    min-height: 30px;
    border: none;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #6df5c4;
}

QScrollBar::handle:vertical:pressed {
    background: #52d9ab;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: transparent;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

/* Horizontal Scrollbar */
QScrollBar:horizontal {
    height: 10px;
    background: #191e2d;
    border: none;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #454b5a;
    min-width: 30px;
    border: none;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #6df5c4;
}

QScrollBar::handle:horizontal:pressed {
    background: #52d9ab;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
    background: transparent;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* =========================================================
   SCAN BAR
   ========================================================= */

QWidget#scanBar {
    background: #10131d;
    border: none;
}

/* Scanning status text */
QLabel#scanLabel {
    background: transparent;
    color: #6df5c4;
    font-size: 14px;
    font-weight: bold;
}

/* =========================================================
   LOADOUT NAME
   ========================================================= */

QLabel#loadoutName {
    font-size: 14px;
    font-weight: bold;
    color: #f4f6ff;
}

/* =========================================================
   LOADOUT RESULT MESSAGE
   ========================================================= */

QLabel#loadoutResult {
    color: #ffffff;
    font-weight: bold;
    font-size: 14px;
    background: transparent;
}

/* =========================================================
   THREE-SECOND COUNTDOWN BAR
   ========================================================= */

QProgressBar#scanProgressIndicator {
    background-color: #252b3e;
    border: none;
    border-radius: 3px;
    min-height: 6px;
    max-height: 6px;
    text-align: center;
}

/* Countdown Fill */
QProgressBar#scanProgressIndicator::chunk {
    background-color: #6df5c4;
    border-radius: 3px;
}

QLabel#loadoutResultText {
    background: transparent;
    color: #6df5c4;
    font-size: 15px;
    font-weight: bold;
}

QLabel#scanCancelHint {
    background: transparent;
    color: #8992ad;
    font-size: 11px;
}

QWidget#loadoutResultContainer {
    background: transparent;
}
